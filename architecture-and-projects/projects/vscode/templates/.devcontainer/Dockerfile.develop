# syntax=docker/dockerfile:1

ARG BASE_IMAGE=robotics-base:humble
FROM ${BASE_IMAGE}

ARG USERNAME=develop

USER root

# 安装项目级代码质检门禁与测试/基准依赖（置于源码 COPY 前以充分利用 Docker 缓存）
RUN apt-get update && apt-get install -y --no-install-recommends \
        clang-tidy \
        doxygen \
        python3-pip \
        libgtest-dev \
        libbenchmark-dev \
    && pip3 install --no-cache-dir \
        pre-commit \
        gitlint \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

USER ${USERNAME}
WORKDIR /workspace

# 拷贝项目源码与配置（务必配合 .dockerignore 排除 .git、build/、install/、log/）
COPY --chown=${USERNAME}:${USERNAME} . /workspace

# 自动加载项目工作区环境变量（编过即生效，未编译时不报错）
RUN echo '[ -f /workspace/install/setup.bash ] && source /workspace/install/setup.bash' >> ~/.bashrc

CMD ["/bin/bash"]
