# syntax=docker/dockerfile:1

ARG BASE_IMAGE=robotics-base:humble
FROM ${BASE_IMAGE}

ARG USERNAME=develop

WORKDIR /workspace

# 拷贝项目源码与配置（务必配合 .dockerignore 排除 .git、build/、install/、log/）
COPY --chown=${USERNAME}:${USERNAME} . /workspace

# 自动加载项目工作区环境变量（编过即生效，未编译时不报错）
RUN echo '[ -f /workspace/install/setup.bash ] && source /workspace/install/setup.bash' >> ~/.bashrc

CMD ["/bin/bash"]
