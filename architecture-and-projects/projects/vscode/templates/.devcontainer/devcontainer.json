{
  "name": "robotics-middleware-dev",
  "build": {
    "dockerfile": "Dockerfile.develop",
    "context": ".."
  },
  "remoteUser": "develop",
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=delegated",
  "mounts": [
    "source=${localEnv:HOME}/Project,target=/projects,type=bind,consistency=delegated"
  ],
  "runArgs": [
    "--name=midplatform-dev",
    "--cap-add=SYS_PTRACE",
    "--security-opt",
    "seccomp=unconfined"
  ],
  "containerEnv": {
    "ROS_DOMAIN_ID": "42"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "llvm-vs-code-extensions.vscode-clangd",
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "ms-vscode.makefile-tools",
        "ms-python.python",
        "Ranch-Hand-Robotics.rde-ros-2",
        "redhat.vscode-yaml",
        "redhat.vscode-xml",
        "eamodio.gitlens",
        "mhutchie.git-graph",
        "usernamehw.errorlens",
        "gruntfuggly.todo-tree",
        "GitHub.copilot",
        "Continue.continue"
      ]
    }
  }
}
